NEXT_PUBLIC_SITE_URL=https://pushtakim.co.il
TICKET_PROVIDER=static
TICKET_PROVIDER_API_URL=
TICKET_PROVIDER_API_KEY=

# Central sales database: Vercel KV / Upstash Redis REST
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Admin protection for /admin and /api/admin/*
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Shared secret required by /api/grow/webhook
GROW_WEBHOOK_SECRET=

# Email notification containing the full registration form (Resend)
RESEND_API_KEY=
REGISTRATION_NOTIFICATION_EMAIL=
REGISTRATION_EMAIL_FROM=PushTakim <registrations@your-domain.example>

# Temporary manual override until Grow webhook reconciliation is fully verified.
# Counts confirmed paid opening tickets for the 100 ILS launch offer.
OPENING_TICKETS_SOLD_OVERRIDE=

# Optional private signing secret for the existing admin fallback login.
# Required if ADMIN_USERNAME/ADMIN_PASSWORD are not configured.
ADMIN_SESSION_SECRET=

# Separate Dubnov quick-payment route. Use this merchant's Grow Light API setup.
# Keep disabled until a real Grow sandbox payment page and receipt are verified.
GROW_QUICK_PAYMENT_ENABLED=false
GROW_API_ORIGIN=
GROW_USER_ID=
GROW_PAGE_CODE=
# 1 = including VAT, 3 = tax exempt; confirm the merchant's receipt configuration.
GROW_VAT_TYPE=
